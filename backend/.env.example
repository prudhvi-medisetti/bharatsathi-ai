# Required for real Gemini responses. Keep this file server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin service account. Set exactly one credential source.
# Prefer a path to a protected service-account file in local development.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_PROJECT_ID=bharatsathi-ai-1aed0
FIREBASE_STORAGE_BUCKET=bharatsathi-ai-1aed0.firebasestorage.app

# High-entropy server-only secret (for example: python -c "import secrets; print(secrets.token_urlsafe(48))").
RECOVERY_CODE_PEPPER=
RECOVERY_CODE_TTL_SECONDS=31536000
RECOVERY_CODE_MAX_ATTEMPTS=5
RECOVERY_CODE_ATTEMPT_INTERVAL_SECONDS=5
RECOVERY_CODE_HASH_ITERATIONS=310000

# Document download PIN policy (TTL: 1-60 minutes; max attempts: 1-10).
DOCUMENT_PIN_TTL_SECONDS=600
DOCUMENT_PIN_MAX_ATTEMPTS=5

# Branded verification, account recovery, email-change, and document notifications require SMTP.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173
EMAIL_CHANGE_TOKEN_TTL_SECONDS=1800
EMAIL_CHANGE_RESEND_INTERVAL_SECONDS=60
EMAIL_CHANGE_MAX_RESENDS=5
EMAIL_CHANGE_MAX_CONFIRM_ATTEMPTS=5
EMAIL_CHANGE_RECENT_AUTH_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BharatSathi AI <noreply@example.com>

# Comma-separated frontend origins allowed to call the backend.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://bharatsathi-ai-1aed0.web.app,https://bharatsathi-ai-1aed0.firebaseapp.com

HOST=0.0.0.0
PORT=8000
